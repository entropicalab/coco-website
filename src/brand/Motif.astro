---
// The canopy: one circle per layout (brand book v3, "canopy over plan").
// A flat green, or a photo. Never holds text; may leave the frame. Purely decorative.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { class?: string; image?: ImageMetadata; tone?: 'green' | 'water' }
const { class: className, image, tone = 'green' } = Astro.props;
---
<span class:list={['canopy', `canopy--${tone}`, className]} aria-hidden="true">
  {image && <Image src={image} alt="" widths={[400, 800]} sizes="40vw" />}
</span>

<style>
  .canopy { display: block; aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--color-botanic); pointer-events: none; }
  .canopy--water { background: var(--color-botanic-soft); }
  .canopy :global(img) { width: 100%; height: 100%; object-fit: cover; }
</style>
