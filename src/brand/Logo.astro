---
// Brand logo: leaf mark + wordmark (Inter, all capitals, wide tracking).
// variant: "full" (leaf + name) | "mark" (leaf only). tone: "default" (on light) | "inverse" (on dark).
import { Image } from 'astro:assets';
import leafInk from '../assets/brand/leaf-ink.png';
import leafLight from '../assets/brand/leaf-light.png';
interface Props { variant?: 'full' | 'mark'; tone?: 'default' | 'inverse'; size?: number }
const { variant = 'full', tone = 'default', size = 36 } = Astro.props;
const leaf = tone === 'inverse' ? leafLight : leafInk;
---
<span class:list={['logo', `logo--${tone}`]} style={`--logo-size:${size}px`}>
  <Image class="logo__mark" src={leaf} alt="" width={size * 2} height={size * 2} loading="eager" />
  {variant === 'full' && <span class="logo__word">Coronado Commons</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: calc(var(--logo-size) * 0.45); color: var(--color-ink); }
  .logo--inverse { color: var(--color-inverse-ink); }
  .logo :global(.logo__mark) { width: var(--logo-size); height: var(--logo-size); flex: none; object-fit: contain; }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: max(0.8rem, calc(var(--logo-size) * 0.4));
    letter-spacing: 0.34em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @media (max-width: 480px) {
    .logo__word { font-size: 0.7rem; letter-spacing: 0.2em; }
  }
</style>
