---
import '../styles/theme.css';
import '../styles/base.css';
import Fonts from '../brand/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';
import ogDefault from '../assets/renders/atrium.jpg';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;          // page title (site name is appended)
  description?: string;
  ogImage?: ImageMetadata;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  headerTone?: 'default' | 'overlay'; // overlay = transparent header over a full-bleed hero
  noindex?: boolean;
}
const { title, description = site.description, ogImage = ogDefault, jsonLd, headerTone = 'default', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site ?? site.url).href;

const complexLd = {
  '@context': 'https://schema.org',
  '@type': 'ApartmentComplex',
  name: site.name,
  alternateName: site.shortName,
  description: site.description,
  url: site.url,
  email: site.salesEmail,
  numberOfAccommodationUnits: site.stats.residences,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  ...(site.geo.lat && site.geo.lng ? { geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng } } : {}),
};
const ld = [complexLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <Fonts />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header tone={headerTone} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
