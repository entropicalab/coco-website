---
// The one inquiry form used across the site.
// Sent through Formspree, which emails each
// inquiry to sales@lifeatcoco.com. Endpoint lives in site.json → form.formspreeEndpoint.
// Until that is set, the form falls back to opening the visitor's email app.
import site from '../data/site.json';
interface Props {
  interest?: string;        // pre-selects/pre-fills what the visitor is asking about
  id?: string;
}
const { interest = '', id = 'inquiry' } = Astro.props;
const interests = [
  'A residence (any type)',
  'Type A · 1 bedroom', 'Type F · 1 bedroom',
  'Type B · 2 bedrooms', 'Type G · 2 bedrooms', 'Type C · 2 bedrooms', 'Type E · 2 bedrooms', 'Type D · 2 bedrooms',
  'Type H · 3 bedrooms', 'Type I · 3 bedrooms',
  'Commercial unit',
  'Something else',
];
const known = interests.find((i) => interest && i.toLowerCase().startsWith(interest.toLowerCase()));
const endpoint = site.form.formspreeEndpoint;
const action = endpoint ?? `mailto:${site.salesEmail}?subject=${encodeURIComponent(site.form.subject)}`;
const thankYou = new URL('/thank-you', site.url).href;
---
<form
  class="inquiry"
  id={id}
  name="inquiry"
  method="POST"
  action={action}
  enctype={endpoint ? undefined : 'text/plain'}
  data-inquiry={endpoint ? 'ajax' : 'mailto'}
>
  {endpoint && (
    <>
      <input type="hidden" name="_subject" value={site.form.subject} />
      <input type="hidden" name="_next" value={thankYou} />
      <p class="visually-hidden" aria-hidden="true">
        <label>Leave this empty <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </p>
    </>
  )}

  <div class="inquiry__grid">
    <div class="field">
      <label for={`${id}-name`}>Your name</label>
      <input id={`${id}-name`} name="name" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={`${id}-email`}>Email</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for={`${id}-phone`}>Phone or WhatsApp <span class="hint">(optional)</span></label>
      <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" />
    </div>
    <div class="field">
      <label for={`${id}-country`}>Where do you live now?</label>
      <input id={`${id}-country`} name="country" autocomplete="country-name" />
    </div>
    <div class="field">
      <label for={`${id}-interest`}>I'm interested in</label>
      <select id={`${id}-interest`} name="interest">
        {interests.map((i) => <option selected={i === known}>{i}</option>)}
      </select>
    </div>
    <div class="field">
      <label for={`${id}-timeframe`}>When are you thinking of moving?</label>
      <select id={`${id}-timeframe`} name="timeframe">
        <option>Just exploring</option>
        <option>Within 1–2 years</option>
        <option>As soon as it's ready</option>
        <option>Not moving — buying for family or to invest</option>
      </select>
    </div>
    <div class="field inquiry__full">
      <label for={`${id}-message`}>Anything you'd like to ask? <span class="hint">(optional)</span></label>
      <textarea id={`${id}-message`} name="message" rows="4"></textarea>
    </div>
  </div>

  <div class="inquiry__foot">
    <button class="btn btn--primary" type="submit">Send inquiry</button>
    <p class="inquiry__error" role="alert" hidden>
      Something went wrong and your message wasn’t sent. Please try again, or email
      <a href={`mailto:${site.salesEmail}`}>{site.salesEmail}</a>.
    </p>
    <p class="small muted">
      We reply personally, usually within two working days. Prefer email?
      Write to <a href={`mailto:${site.salesEmail}`}>{site.salesEmail}</a>.
    </p>
  </div>
</form>

<script>
  // Send through Formspree without leaving the page, then go to /thank-you.
  // Without JavaScript the form still posts normally and Formspree redirects via _next.
  document.querySelectorAll<HTMLFormElement>('form[data-inquiry="ajax"]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const error = form.querySelector<HTMLElement>('.inquiry__error');
      if (button) { button.disabled = true; button.textContent = 'Sending…'; }
      if (error) error.hidden = true;
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        window.location.href = '/thank-you';
      } catch {
        if (error) error.hidden = false;
        if (button) { button.disabled = false; button.textContent = 'Send inquiry'; }
      }
    });
  });
</script>

<style>
  .inquiry { display: grid; gap: 2rem; }
  .inquiry__grid { display: grid; gap: 1.4rem 1.5rem; }
  .inquiry__grid .field { align-content: end; }
  @media (min-width: 720px) {
    .inquiry__grid { grid-template-columns: 1fr 1fr; }
    .inquiry__full { grid-column: 1 / -1; }
  }
  .inquiry__foot { display: grid; gap: 1rem; justify-items: start; }
  .inquiry__error { color: var(--color-ink); background: var(--color-highlight); padding: 0.8rem 1rem; border-radius: var(--radius-sm); }
</style>
