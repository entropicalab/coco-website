<style>
  .maps { display: grid; gap: 1.25rem; }
  @media (min-width: 1000px) { .maps { grid-template-columns: 1fr 1.835fr 1fr; align-items: start; } }
  @media (min-width: 640px) and (max-width: 999px) {
    .maps { grid-template-columns: 1fr 1fr; }
    .map--country { grid-column: 1 / -1; order: -1; }
    .map--globe { order: -2; grid-column: 1 / -1; max-width: 420px; justify-self: center; width: 100%; }
  }
  .map { display: grid; gap: 0.75rem; margin: 0; }
  .map svg {
    display: block; width: 100%; height: auto;
    border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: var(--color-surface, #fff);
  }
  .map figcaption { display: flex; gap: 0.6rem; align-items: baseline; font-size: 0.95rem; color: var(--color-text-muted); max-width: 40ch; }
  .map__step { font-family: var(--font-display); font-size: 0.78rem; font-weight: 500; color: var(--color-ink); flex: none; }

  .map__sea { fill: var(--color-surface, #fff); }
  .map__band { fill: color-mix(in srgb, var(--color-highlight) 30%, transparent); }
  .map__land { fill: var(--color-tint-1); }
  .map__near { fill: color-mix(in srgb, var(--color-tint-1) 42%, #fff); }
  .map__home { fill: var(--color-ink); }
  .map__border { fill: none; stroke: #fff; stroke-width: 0.6; }
  .map__lat { fill: none; stroke: var(--color-ink); stroke-width: 0.8; stroke-dasharray: 3 4; opacity: 0.55; }
  .map__lat--eq { stroke-dasharray: 1 4; opacity: 0.35; }
  .map__outline { fill: none; stroke: var(--color-ink); stroke-width: 1; }
  .map__box { fill: none; stroke: var(--color-ink); stroke-width: 1.5; }
  .map__road { fill: none; stroke: var(--color-ink); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 0.012 0.012; }
  .map__dot { fill: var(--color-ink); }
  .map__dot--open { fill: #fff; stroke: var(--color-ink); stroke-width: 2; }
  .map__pin { fill: var(--color-highlight); stroke: var(--color-ink); stroke-width: 2; }
  .map__pin-halo { fill: color-mix(in srgb, var(--color-highlight) 45%, transparent); transform-box: fill-box; transform-origin: center; }

  .map__label { font-family: var(--font-body); font-size: 15px; fill: var(--color-ink); paint-order: stroke; stroke: #fff; stroke-width: 4px; stroke-linejoin: round; }
  .map--country .map__label { font-size: 19px; }
  .map__label--sm { font-size: 12.5px; }
  .map--country .map__label--sm { font-size: 15px; }
  .map__label--strong { font-family: var(--font-display); font-weight: 500; text-transform: uppercase; letter-spacing: 0.12em; }
  .map__label--muted { fill: var(--color-text-muted); }
  .map__sea-label { font-family: var(--font-accent); font-style: italic; font-size: 17px; fill: var(--color-text-muted); }
  .map--country .map__sea-label { font-size: 22px; }

  .map--globe .map__pin { stroke-width: 1.5; }
  @media (max-width: 639px) {
    .map--country .map__label { font-size: 30px; }
    .map--country .map__label--sm { font-size: 24px; }
