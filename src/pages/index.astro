---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import ResidenceCard from '../components/ResidenceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import LocationMaps from '../components/LocationMaps.astro';
import Motif from '../brand/Motif.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import site from '../data/site.json';
import { formatPrice, residencePrice } from '../lib/format';

import facade from '../assets/renders/facade.jpg';
import atrium from '../assets/renders/atrium.jpg';
import walkway from '../assets/renders/walkway.jpg';
import cafe from '../assets/renders/cafe-bookstore.jpg';
import aerial from '../assets/location/aerial.jpg';
import couple from '../assets/photos/couple-bench.jpg';
import friends from '../assets/photos/couple-garden-table.jpg';
import mural from '../assets/photos/banana-mural.jpg';

const residences = (await getCollection('residences')).sort((a, b) => a.data.size - b.data.size);
// One of each bedroom count for the teaser
const teaser = [1, 2, 3].map((n) => residences.find((r) => r.data.bedrooms === n)!).filter(Boolean);
const prices = residences.map((r) => residencePrice(r.data)).filter((p): p is number => p != null);
const lowest = prices.length ? Math.min(...prices) : null;
const amenities = (await getCollection('amenities')).sort((a, b) => a.data.order - b.data.order);
const s = site.stats;
const muralBg = await getImage({ src: mural, width: 1800, format: 'webp' });
---
<Base>
  <!-- Hero: the plan (text) beside the building, one canopy crossing the corner -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__plan">
        <p class="eyebrow">Coronado, Panamá</p>
        <h1 class="display hero__title"><span class="hero__line">Independent living,</span> together <em>{s.residences} homes around a garden, designed for life after sixty.</em></h1>
        <p class="hero__lede">Your own front door, your own routine, and good company a few steps away. Open to anyone; designed, detail by detail, for the decades ahead.</p>
        <div class="btn-row">
          <a class="btn btn--accent" href="/contact">Book a visit</a>
          <a class="hero__link" href="/the-building">Explore the building</a>
        </div>
      </div>
      <div class="hero__media">
        <Figure src={facade} alt="Watercolour of Coronado Commons from the street: a five-storey building with planted balconies, warm timber panels and parking under a canopy." ratio="5/6" loading="eager" widths={[480, 843]} sizes="(min-width: 1000px) 42vw, 100vw" />
        <Motif class="hero__canopy" />
      </div>
    </div>
  </section>

  <!-- Key facts -->
  <section class="section--tight">
    <div class="container">
      <dl class="facts">
        <div><dt><Icon name="apartment" />Residences</dt><dd>{s.residences}</dd></div>
        <div><dt><Icon name="square_foot" />Sizes</dt><dd>{s.sizeMin}–{s.sizeMax}<small> m²</small></dd></div>
        <div><dt><Icon name="bed" />Bedrooms</dt><dd>{s.bedroomsMin}–{s.bedroomsMax}</dd></div>
        <div><dt><Icon name="sell" />Prices</dt><dd class="facts__price">{lowest ? formatPrice(lowest) : 'On request'}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Where it is: three maps, zooming in -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2 class="h2">Where it is <em>On Panamá’s Pacific coast, nine degrees north of the equator.</em></h2>
        <p>Warm all year, in the tropics, and a short flight from North and South America. Coronado is an hour and a quarter from Panama City by highway.</p>
      </div>
      <LocationMaps />
    </div>
  </section>

  <!-- Who it's for -->
  <section class="section section--tint-1">
    <div class="container split split--wide-left">
      <Figure src={couple} alt="Two residents laughing together on a garden bench, among tropical plants and a screen wall." ratio="4/3" illustrative={false} sizes="(min-width: 900px) 55vw, 100vw" />
      <div class="stack">
        <h2 class="h2">Built for a long life <em>Designed for life after sixty. Open to anyone.</em></h2>
        <p>Coronado Commons is for people who want their own home and their own routine, with neighbours they know by name. It isn’t assisted living, and it isn’t a resort.</p>
        <p>It’s a small neighbourhood in one building: step-free throughout, walkable to Coronado’s shops, banks and clinics, and arranged so that seeing people is part of the day rather than an appointment.</p>
      </div>
    </div>
  </section>

  <!-- Shade, light and air -->
  <section class="section section--alt">
    <div class="container split split--wide-right">
      <div class="stack">
        <h2 class="h2">Shade, light and air <em>The building handles the heat. You enjoy the day.</em></h2>
        <p>The building is one home deep. Every residence faces south, toward the light, and an open walkway runs behind it to catch the breeze. Air moves through every home, and deep shade keeps the terraces comfortable at midday.</p>
        <p>No home looks onto a corridor. None faces a wall.</p>
        <p><a class="text-link" href="/sustainability">How the building stays cool</a></p>
      </div>
      <Figure src={walkway} alt="Watercolour of the open-air walkway: brick paving under a timber ceiling, with planting along the rail." ratio="4/5" widths={[480, 940]} sizes="(min-width: 900px) 40vw, 100vw" class="tall" />
    </div>
  </section>

  <!-- The commons -->
  <section class="section section--tint-3">
    <div class="container">
      <div class="section-head">
        <h2 class="h1">A garden at the centre <em>{s.residences} homes. Never more than forty neighbours.</em></h2>
        <p class="lede">A daylit garden atrium rises through every floor. You cross it on the way to the lift, to the café and to the street, and that’s where you get to know people.</p>
      </div>
      <div class="commons__media">
        <Figure src={atrium} alt="Watercolour of the atrium: balconies and walkways on several levels around a planted courtyard with café tables." ratio="16/10" sizes="(min-width: 900px) 62vw, 100vw" />
        <Figure src={friends} alt="Two friends talking over iced drinks at a garden table." ratio="4/5" illustrative={false} sizes="(min-width: 900px) 32vw, 100vw" />
      </div>
    </div>
  </section>

  <!-- Residences teaser -->
  <section class="section section--herringbone">
    <div class="container">
      <div class="section-head">
        <h2 class="h2">The homes <em>Nine layouts, one to three bedrooms.</em></h2>
        <p>From an easy one-bedroom of {s.sizeMin} m² to three-bedroom homes of up to {s.sizeMax} m², with room for family when they visit. Every home has a terrace.</p>
      </div>
      <div class="grid" style="--min:300px">
        {teaser.map((r) => <ResidenceCard residence={r} />)}
      </div>
      <p style="margin-top:2.5rem"><a class="btn btn--primary" href="/residences">See all {s.residenceTypes} homes</a></p>
    </div>
  </section>

  <!-- Living -->
  <section class="section section--tint-2">
    <div class="container split split--wide-right">
      <div class="stack">
        <h2 class="h2">Living here <em>Your morning coffee is downstairs.</em></h2>
        <p>The ground floor is planned as a small high street of its own, with a café, a bookstore and a pharmacy, open to residents and the town. Upstairs, a rooftop room for classes and evenings above the trees.</p>
        <ul class="amen">
          {amenities.slice(0, 7).map((a) => (
            <li>
              <span class="icon-row"><Icon name={a.data.icon} />{a.data.name}</span>
              {!a.data.confirmed && <span class="tag tag--planned">Planned</span>}
            </li>
          ))}
        </ul>
        <p><a class="text-link" href="/living">Daily life at Coronado Commons</a></p>
      </div>
      <Figure src={cafe} alt="Watercolour of the planned café and bookstore: armchairs, bookshelves and full-height glass opening to a planted terrace." ratio="4/3" sizes="(min-width: 900px) 55vw, 100vw" />
    </div>
  </section>

  <!-- Coronado -->
  <section class="section section--alt">
    <div class="container split">
      <Figure src={aerial} alt="Aerial view of Coronado: low-rise neighbourhoods among dense tropical trees." ratio="4/3" illustrative={false} sizes="(min-width: 900px) 50vw, 100vw" />
      <div class="stack">
        <h2 class="h2">Coronado, Panamá <em>An established town, already working.</em></h2>
        <p>Coronado is one of Panamá’s most settled coastal communities, with a large international population, and supermarkets, banks, clinics and the beach close by. Panama City is about an hour and a quarter away by highway.</p>
        <p><a class="text-link" href="/coronado">Why Coronado</a></p>
      </div>
    </div>
  </section>

  <!-- Commercial teaser: the plan panel on the painted banana garden -->
  <section class="section--tight">
    <div class="container">
      <div class="commercial-teaser" style={`background-image:url(${muralBg.src})`}>
        <div class="commercial-teaser__plan stack" style="--stack:.75rem">
          <h2 class="h3">For businesses</h2>
          <p>Ground-floor commercial units, about {s.commercialArea} m² in all, for operators and owners who want to serve the building and the town around it.</p>
          <p><a class="btn btn--accent" href="/commercial">Commercial units</a></p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(2rem, 1rem + 3vw, 4.5rem) clamp(2rem, 1rem + 3vw, 4rem); overflow: hidden; }
  .hero__grid { display: grid; gap: 0; align-items: stretch; }
  .hero__plan {
    background: var(--color-inverse-bg); color: var(--color-inverse-ink);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    padding: clamp(2rem, 1.2rem + 3vw, 4.5rem); display: grid; gap: 1.6rem; align-content: center;
  }
  .hero__plan .eyebrow { color: var(--color-highlight); }
  .hero__plan .display { color: var(--color-inverse-ink); }
  .hero__title { font-size: clamp(1.55rem, 1rem + 1.7vw, 2.45rem); }
  .hero__title em { font-size: 1.25em; }
  @media (min-width: 560px) { .hero__line { white-space: nowrap; } }
  .hero__plan .display em { max-width: 26ch; }
  .hero__lede { color: var(--color-inverse-muted); max-width: 40ch; }
  .hero__link { color: var(--color-inverse-ink); font-family: var(--font-display); font-weight: 500; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.2em; text-decoration: none; padding: 0.9rem 0.25rem; border-bottom: 2px solid transparent; }
  .hero__link:hover { border-bottom-color: var(--color-highlight); }
  .hero__media { position: relative; }
  .hero__media :global(.figure) { height: 100%; }
  .hero__media :global(.figure__media) { height: 100%; border-radius: 0 0 var(--radius-lg) var(--radius-lg); }
  .hero :global(.hero__canopy) { position: absolute; width: clamp(140px, 22vw, 300px); right: -60px; top: -60px; z-index: -0; mix-blend-mode: multiply; }
  @media (min-width: 1000px) {
    .hero__grid { grid-template-columns: 1.15fr 1fr; }
    .hero__plan { border-radius: var(--radius-lg) 0 0 var(--radius-lg); }
    .hero__media :global(.figure__media) { border-radius: 0 var(--radius-lg) var(--radius-lg) 0; }
    .hero :global(.hero__canopy) { right: -110px; top: -90px; }
  }

  .facts { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  @media (min-width: 800px) { .facts { grid-template-columns: repeat(4, 1fr); } }
  .facts > div { padding: 1.5rem 1rem 1.5rem 0; display: grid; gap: 0.35rem; }
  .facts dt { display: flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); font-size: 0.78rem; letter-spacing: var(--eyebrow-tracking); text-transform: uppercase; font-weight: 500; color: var(--color-accent-text); }
  .facts dd { font-family: var(--font-display); font-weight: 400; letter-spacing: 0.06em; font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem); color: var(--color-ink); line-height: 1.1; }
  .facts dd small { font-size: 0.5em; }
  .facts__price { font-family: var(--font-accent) !important; font-style: italic; letter-spacing: 0 !important; font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem) !important; }

  .split :global(.tall) { max-width: 460px; width: 100%; justify-self: center; }

  .commons__media { display: grid; gap: clamp(1rem, 0.5rem + 1.5vw, 2rem); }
  @media (min-width: 900px) { .commons__media { grid-template-columns: 2fr 1fr; align-items: end; } }

  .amen { list-style: none; padding: 0; border-top: 1px solid var(--color-line); }
  .amen li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--color-line); color: var(--color-ink); max-width: none; }

  .commercial-teaser { padding: clamp(1.25rem, 1rem + 4vw, 4.5rem); border-radius: var(--radius-lg); background-size: cover; background-position: center; }
  .commercial-teaser__plan { background: var(--color-inverse-bg); color: var(--color-inverse-ink); padding: clamp(1.75rem, 1.2rem + 2vw, 3rem); max-width: 36rem; border-radius: var(--radius-md); }
  .commercial-teaser__plan .h3 { color: var(--color-inverse-ink); text-transform: uppercase; letter-spacing: 0.2em; font-weight: 400; }
</style>
