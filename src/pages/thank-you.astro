---
import Base from '../layouts/Base.astro';
---
<Base title="Thank you" description="Your inquiry has been sent." noindex>
  <section class="section">
    <div class="container--narrow stack" style="--stack:1.5rem">
      <h1 class="h1">Thank you <em>We’ll be in touch.</em></h1>
      <p class="lede">A real person will reply, usually within two working days. In the meantime, have a look around.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/residences">Browse the residences</a>
        <a class="btn btn--ghost" href="/">Back to home</a>
      </div>
    </div>
  </section>
</Base>
