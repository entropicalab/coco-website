---
import Base from '../layouts/Base.astro';
import InquiryForm from '../components/InquiryForm.astro';
import Motif from '../brand/Motif.astro';
import site from '../data/site.json';
---
<Base title="Inquire" description="Ask about residences or commercial units at Coronado Commons. We’ll send plans, prices and availability, and answer personally.">
  <section class="section">
    <div class="container contact">
      <div class="stack contact__intro">
        <p class="eyebrow">Inquire</p>
        <h1 class="h1">Let’s talk.</h1>
        <p class="lede">Tell us a little about what you’re looking for. We’ll send plans, prices and availability, and answer your questions personally.</p>
        <div class="stack" style="--stack:0.4rem">
          <p class="muted">Or write to us directly:</p>
          <p><a class="text-link" href={`mailto:${site.salesEmail}`}>{site.salesEmail}</a></p>
          {site.phone && <p><a class="text-link" href={`tel:${site.phone.replace(/[\s-]/g, '')}`}>{site.phone}</a></p>}
        </div>
        <Motif class="contact__motif" />
      </div>
      <div class="contact__form">
        <InquiryForm id="contact-inquiry" />
      </div>
    </div>
  </section>
</Base>

<script>
  // Pre-select the "I'm interested in" field from ?interest=... links
  const want = new URLSearchParams(location.search).get('interest');
  const select = document.querySelector<HTMLSelectElement>('#contact-inquiry-interest');
  if (want && select) {
    const opt = [...select.options].find((o) => o.text.toLowerCase().startsWith(want.toLowerCase()));
    if (opt) select.value = opt.value;
  }
</script>

<style>
  .contact { display: grid; gap: 3rem; align-items: start; }
  @media (min-width: 1000px) { .contact { grid-template-columns: 1fr 1.3fr; gap: 6rem; } }
  .contact__intro { position: relative; }
  .contact :global(.contact__motif) { width: 220px; margin-top: 3rem; color: var(--color-ink); }
  .contact__form { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg); padding: clamp(1.5rem, 1rem + 2vw, 3rem); }
</style>
