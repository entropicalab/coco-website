---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn’t exist.">
  <section class="section">
    <div class="container--narrow stack" style="--stack:1.5rem">
      <h1 class="h1">Page not found <em>This door doesn’t open onto anything.</em></h1>
      <p class="lede">The page you were looking for has moved or never existed.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Go to the home page</a>
        <a class="btn btn--ghost" href="/residences">See the residences</a>
      </div>
    </div>
  </section>
</Base>
