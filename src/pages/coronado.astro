---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import CtaBand from '../components/CtaBand.astro';
import site from '../data/site.json';
import aerial from '../assets/location/aerial.jpg';
import horizon from '../assets/drone/view-horizon.jpg';

const nearby = [
  { what: 'Supermarkets, banks & pharmacies', where: 'A few minutes away' },
  { what: 'Private clinics', where: 'In town' },
  { what: 'The beach', where: 'Short drive' },
  { what: 'Río Hato international airport', where: 'About 30 minutes' },
  { what: 'Panama City', where: 'About 1 hour 15 minutes by highway' },
];
---
<Base title="Coronado, Panamá" description="Why Coronado: one of Panamá’s most established Pacific-coast towns, with a large international community, everyday services close by, and Panama City about an hour away.">
  <section class="section section--tight">
    <div class="container section-head">
      <p class="eyebrow">Location</p>
      <h1 class="h1">Coronado, <em>Panamá.</em></h1>
      <p class="lede">An established beach town on the Pacific coast, where Panamanian families and people from all over the world have been settling for decades.</p>
    </div>
    <div class="container">
      <Figure src={aerial} alt="Aerial photo of Coronado: low-rise homes among dense tropical trees." ratio="21/9" illustrative={false} loading="eager" />
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="stack">
        <p class="eyebrow">Why here</p>
        <h2 class="h2">A real town, already working.</h2>
        <p>Coronado isn’t a resort that needs time to fill in. It has supermarkets, banks, restaurants, clinics and a large, friendly international community — the kind of place where you can arrive and have a life within weeks.</p>
        <p>Panamá offers a warm climate all year, the US dollar as its currency, and a well-known residency programme for retirees.</p>
      </div>
      <dl class="nearby">
        {nearby.map((n) => <div><dt>{n.what}</dt><dd>{n.where}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split split--wide-left">
      <Figure src={horizon} alt="Drone photo from the site: green lawns and treetops under a wide sky, with distant buildings on the horizon." ratio="4/3" illustrative={false} caption="Drone photo taken over the site." />
      <div class="stack">
        <p class="eyebrow">The site</p>
        <h2 class="h2">On {site.address.street}.</h2>
        <p>The building sits on Coronado’s main avenue, close to everyday services. To the south lie the wide, treed grounds of the neighbouring property — the green outlook every home faces.</p>
        <p class="muted small">Exact address and directions are shared on request.</p>
      </div>
    </div>
  </section>

  <CtaBand title="Visiting Coronado? Let’s meet." text="Tell us when you’ll be in Panamá. We’ll walk you round the site and the town." interest="Something else" />
</Base>

<style>
  .nearby { display: grid; border-top: 1px solid var(--color-line); }
  .nearby > div { display: flex; justify-content: space-between; gap: 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--color-line); }
  .nearby dt { color: var(--color-ink); font-weight: 600; }
  .nearby dd { color: var(--color-text-muted); text-align: right; }
</style>
